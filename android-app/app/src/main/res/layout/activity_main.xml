<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BARH Network Fix"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:textColor="#2196F3" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 جاري التحميل..."
        android:textSize="18sp"
        android:padding="12dp"
        android:background="#ffffff"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <TextView
        android:id="@+id/latencyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏓 التأخير: --"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="#ffffff"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <TextView
        android:id="@+id/recommendationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎯 التوصية: --"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="#ffffff"
        android:layout_marginBottom="20dp"
        android:elevation="2dp" />

    <Button
        android:id="@+id/testButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 اختبار الآن"
        android:textSize="18sp"
        android:padding="16dp"
        android:background="#2196F3"
        android:textColor="#ffffff" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="يتم الاختبار تلقائياً كل 10 ثوان"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:textColor="#666666" />

</LinearLayout>
