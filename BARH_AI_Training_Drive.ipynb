   "source": [
    "## 🧠 بناء وتدريب نموذج LSTM"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🏗️ بناء نموذج LSTM مع حفظ في Google Drive\n",
    "class DriveBasedBARHLSTM:\n",
    "    \"\"\"نموذج LSTM مع حفظ في Google Drive\"\"\"\n",
    "    \n",
    "    def __init__(self, project_path, sequence_length=10, features=11):\n",
    "        self.project_path = project_path\n",
    "        self.sequence_length = sequence_length\n",
    "        self.features = features\n",
    "        self.model = None\n",
    "        self.scaler = StandardScaler()\n",
    "        self.history = None\n",
    "        \n",
    "    def build_model(self):\n",
    "        \"\"\"بناء نموذج LSTM متقدم\"\"\"\n",
    "        \n",
    "        print(f\"🏗️ بناء نموذج LSTM للـ MEGA DATASET...\")\n",
    "        \n",
    "        model = Sequential([\n",
    "            # طبقات LSTM متقدمة\n",
    "            LSTM(128, return_sequences=True, input_shape=(self.sequence_length, self.features),\n",
    "                 dropout=0.2, recurrent_dropout=0.2),\n",
    "            BatchNormalization(),\n",
    "            \n",
    "            LSTM(64, return_sequences=True, dropout=0.2, recurrent_dropout=0.2),\n",
    "            BatchNormalization(),\n",
    "            \n",
    "            LSTM(32, return_sequences=False, dropout=0.2, recurrent_dropout=0.2),\n",
    "            BatchNormalization(),\n",
    "            \n",
    "            # طبقات Dense\n",
    "            Dense(64, activation='relu'),\n",
    "            BatchNormalization(),\n",
    "            Dropout(0.3),\n",
    "            \n",
    "            Dense(32, activation='relu'),\n",
    "            BatchNormalization(),\n",
    "            Dropout(0.2),\n",
    "            \n",
    "            Dense(16, activation='relu'),\n",
    "            Dropout(0.1),\n",
    "            \n",
    "            # طبقة الإخراج\n",
    "            Dense(6, activation='sigmoid', name='barh_corrections')\n",
    "        ])\n",
    "        \n",
    "        model.compile(\n",
    "            optimizer=Adam(learning_rate=0.001, beta_1=0.9, beta_2=0.999),\n",
    "            loss='binary_crossentropy',\n",
    "            metrics=['accuracy', 'precision', 'recall']\n",
    "        )\n",
    "        \n",
    "        self.model = model\n",
    "        \n",
    "        # حفظ بنية النموذج\n",
    "        model_architecture = {\n",
    "            'sequence_length': self.sequence_length,\n",
    "            'features': self.features,\n",
    "            'total_params': model.count_params(),\n",
    "            'layers': [str(layer) for layer in model.layers]\n",
    "        }\n",
    "        \n",
    "        arch_file = f'{self.project_path}/models/model_architecture.json'\n",
    "        with open(arch_file, 'w') as f:\n",
    "            json.dump(model_architecture, f, indent=2)\n",
    "        \n",
    "        print(f\"✅ تم بناء النموذج: {model.count_params():,} معامل\")\n",
    "        print(f\"💾 تم حفظ بنية النموذج في: {arch_file}\")\n",
    "        \n",
    "        return model\n",
    "    \n",
    "    def prepare_sequences(self, data, feature_cols, target_cols):\n",
    "        \"\"\"تحضير البيانات مع حفظ المعالج\"\"\"\n",
    "        \n",
    "        print(f\"🔄 تحضير التسلسلات الزمنية...\")\n",
    "        \n",
    "        # تطبيع البيانات\n",
    "        features = self.scaler.fit_transform(data[feature_cols])\n",
    "        targets = data[target_cols].values\n",
    "        \n",
    "        # حفظ المعالج\n",
    "        import joblib\n",
    "        scaler_file = f'{self.project_path}/models/feature_scaler.pkl'\n",
    "        joblib.dump(self.scaler, scaler_file)\n",
    "        print(f\"💾 تم حفظ معالج البيانات في: {scaler_file}\")\n",
    "        \n",
    "        # إنشاء التسلسلات\n",
    "        X, y = [], []\n",
    "        for i in range(len(features) - self.sequence_length):\n",
    "            X.append(features[i:(i + self.sequence_length)])\n",
    "            y.append(targets[i + self.sequence_length])\n",
    "            \n",
    "            if (i + 1) % 10000 == 0:\n",
    "                print(f\"   تم إنشاء {i + 1:,} تسلسل...\")\n",
    "        \n",
    "        X, y = np.array(X), np.array(y)\n",
    "        \n",
    "        # حفظ معلومات التسلسلات\n",
    "        sequence_info = {\n",
    "            'total_sequences': len(X),\n",
    "            'sequence_shape': list(X.shape),\n",
    "            'target_shape': list(y.shape),\n",
    "            'feature_columns': feature_cols,\n",
    "            'target_columns': target_cols\n",
    "        }\n",
    "        \n",
    "        seq_file = f'{self.project_path}/results/sequence_info.json'\n",
    "        with open(seq_file, 'w') as f:\n",
    "            json.dump(sequence_info, f, indent=2)\n",
    "        \n",
    "        print(f\"✅ تم إنشاء {len(X):,} تسلسل\")\n",
    "        print(f\"💾 تم حفظ معلومات التسلسلات في: {seq_file}\")\n",
    "        \n",
    "        return X, y\n",
    "\n",
    "# إنشاء نموذج LSTM\n",
    "lstm_model = DriveBasedBARHLSTM(project_path, sequence_length=10, features=11)\n",
    "model = lstm_model.build_model()\n",
    "\n",
    "# عرض هيكل النموذج\n",
    "print(\"\\n🏗️ هيكل النموذج:\")\n",
    "model.summary()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 📊 تحضير البيانات للتدريب مع حفظ في Drive\n",
    "print(\"🔄 تحضير MEGA DATASET للتدريب...\")\n",
    "\n",
    "# تحضير التسلسلات\n",
    "X, y = lstm_model.prepare_sequences(data, feature_cols, target_cols)\n",
    "\n",
    "# تقسيم البيانات\n",
    "print(f\"\\n📊 تقسيم البيانات...\")\n",
    "X_temp, X_test, y_temp, y_test = train_test_split(X, y, test_size=0.1, random_state=42)\n",
    "X_train, X_val, y_train, y_val = train_test_split(X_temp, y_temp, test_size=0.111, random_state=42)\n",
    "\n",
    "# حفظ معلومات التقسيم\n",
    "split_info = {\n",
    "    'train_samples': len(X_train),\n",
    "    'val_samples': len(X_val),\n",
    "    'test_samples': len(X_test),\n",
    "    'train_percentage': len(X_train) / len(X) * 100,\n",
    "    'val_percentage': len(X_val) / len(X) * 100,\n",
    "    'test_percentage': len(X_test) / len(X) * 100\n",
    "}\n",
    "\n",
    "split_file = f'{project_path}/results/data_split_info.json'\n",
    "with open(split_file, 'w') as f:\n",
    "    json.dump(split_info, f, indent=2)\n",
    "\n",
    "print(f\"✅ تقسيم البيانات:\")\n",
    "print(f\"   📈 التدريب: {len(X_train):,} عينة ({len(X_train)/len(X)*100:.1f}%)\")\n",
    "print(f\"   📊 التحقق: {len(X_val):,} عينة ({len(X_val)/len(X)*100:.1f}%)\")\n",
    "print(f\"   🧪 الاختبار: {len(X_test):,} عينة ({len(X_test)/len(X)*100:.1f}%)\")\n",
    "print(f\"💾 تم حفظ معلومات التقسيم في: {split_file}\")"
   ]
  }
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 🚀 تدريب النموذج مع حفظ تلقائي في Google Drive\n",
    "print(\"🚀 بدء تدريب نموذج LSTM مع حفظ في Google Drive...\")\n",
    "\n",
    "# إعداد مسارات الحفظ\n",
    "model_save_path = f'{project_path}/models/best_barh_lstm_model.h5'\n",
    "weights_save_path = f'{project_path}/models/best_barh_lstm_weights.h5'\n",
    "checkpoint_path = f'{project_path}/models/checkpoint_barh_lstm.h5'\n",
    "\n",
    "# إعداد callbacks مع حفظ في Drive\n",
    "callbacks = [\n",
    "    # إيقاف مبكر\n",
    "    EarlyStopping(\n",
    "        monitor='val_loss',\n",
    "        patience=15,\n",
    "        restore_best_weights=True,\n",
    "        verbose=1,\n",
    "        min_delta=0.001\n",
    "    ),\n",
    "    \n",
    "    # تقليل معدل التعلم\n",
    "    ReduceLROnPlateau(\n",
    "        monitor='val_loss',\n",
    "        factor=0.5,\n",
    "        patience=8,\n",
    "        min_lr=1e-7,\n",
    "        verbose=1\n",
    "    ),\n",
    "    \n",
    "    # حفظ أفضل نموذج في Drive\n",
    "    ModelCheckpoint(\n",
    "        model_save_path,\n",
    "        monitor='val_loss',\n",
    "        save_best_only=True,\n",
    "        verbose=1,\n",
    "        save_weights_only=False\n",
    "    ),\n",
    "    \n",
    "    # حفظ الأوزان فقط\n",
    "    ModelCheckpoint(\n",
    "        weights_save_path,\n",
    "        monitor='val_accuracy',\n",
    "        save_best_only=True,\n",
    "        verbose=1,\n",
    "        save_weights_only=True\n",
    "    )\n",
    "]\n",
    "\n",
    "# بدء التدريب\n",
    "start_time = time.time()\n",
    "print(f\"⏰ بدء التدريب في: {time.strftime('%Y-%m-%d %H:%M:%S')}\")\n",
    "\n",
    "history = model.fit(\n",
    "    X_train, y_train,\n",
    "    batch_size=64,\n",
    "    epochs=100,\n",
    "    validation_data=(X_val, y_val),\n",
    "    callbacks=callbacks,\n",
    "    verbose=1,\n",
    "    shuffle=True\n",
    ")\n",
    "\n",
    "training_time = time.time() - start_time\n",
    "lstm_model.history = history\n",
    "\n",
    "print(f\"\\n✅ انتهى التدريب!\")\n",
    "print(f\"⏰ وقت التدريب: {training_time/60:.1f} دقيقة\")\n",
    "print(f\"📊 عدد العصور: {len(history.history['loss'])}\")\n",
    "print(f\"💾 النموذج محفوظ في: {model_save_path}\")\n",
    "print(f\"💾 الأوزان محفوظة في: {weights_save_path}\")"
   ]
  },
