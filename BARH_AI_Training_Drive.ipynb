   "source": [
    "# 🔍 تحليل جودة البيانات وحفظ التقرير\n",
    "print(\"🔍 تحليل جودة MEGA DATASET...\")\n",
    "\n",
    "# تحديد الأعمدة\n",
    "feature_cols = [\n",
    "    'download_speed', 'upload_speed', 'latency', 'packet_loss', 'jitter',\n",
    "    'bandwidth_utilization', 'connected_devices', 'concurrent_connections', \n",
    "    'time_of_day', 'network_type_encoded', 'location_encoded'\n",
    "]\n",
    "\n",
    "target_cols = [\n",
    "    'buffer_optimization', 'connection_pooling', 'route_optimization',\n",
    "    'adaptive_compression', 'parallel_connections', 'predictive_prefetch'\n",
    "]\n",
    "\n",
    "# تحليل البيانات\n",
    "analysis_report = {\n",
    "    'dataset_info': {\n",
    "        'total_samples': len(data),\n",
    "        'total_features': len(data.columns),\n",
    "        'feature_columns': feature_cols,\n",
    "        'target_columns': target_cols,\n",
    "        'missing_values': data.isnull().sum().sum(),\n",
    "        'duplicates': data.duplicated().sum()\n",
    "    },\n",
    "    'feature_statistics': data[feature_cols].describe().to_dict(),\n",
    "    'target_distribution': {}\n",
    "}\n",
    "\n",
    "# إحصائيات التصحيحات\n",
    "print(f\"\\n🔧 توزيع تصحيحات BARH:\")\n",
    "for col in target_cols:\n",
    "    count = data[col].sum()\n",
    "    percentage = count / len(data) * 100\n",
    "    analysis_report['target_distribution'][col] = {\n",
    "        'count': int(count),\n",
    "        'percentage': round(percentage, 2)\n",
    "    }\n",
    "    print(f\"  {col}: {count:,} ({percentage:.1f}%)\")\n",
    "\n",
    "# حفظ تقرير التحليل في Google Drive\n",
    "report_file = f'{project_path}/results/data_analysis_report.json'\n",
    "with open(report_file, 'w', encoding='utf-8') as f:\n",
    "    json.dump(analysis_report, f, indent=2, ensure_ascii=False)\n",
    "\n",
    "print(f\"\\n💾 تم حفظ تقرير التحليل في: {report_file}\")\n",
    "print(f\"✅ جميع الأعمدة المطلوبة متوفرة!\")"
   ]
