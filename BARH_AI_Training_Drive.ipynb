   "source": [
    "# 🧪 تقييم شامل للنموذج مع حفظ في Drive\n",
    "print(\"🧪 تقييم شامل لنموذج LSTM...\")\n",
    "\n",
    "# تحميل أفضل نموذج\n",
    "best_model = load_model(model_save_path)\n",
    "print(f\"✅ تم تحميل أفضل نموذج من: {model_save_path}\")\n",
    "\n",
    "# التنبؤ على بيانات الاختبار\n",
    "print(\"🔄 التنبؤ على بيانات الاختبار...\")\n",
    "y_pred = best_model.predict(X_test, verbose=1)\n",
    "y_pred_binary = (y_pred > 0.5).astype(int)\n",
    "\n",
    "# حساب المقاييس لكل نوع تصحيح\n",
    "evaluation_results = {\n",
    "    'overall_accuracy': float(np.mean(y_pred_binary == y_test)),\n",
    "    'per_correction_metrics': {}\n",
    "}\n",
    "\n",
    "print(f\"\\n📊 نتائج التقييم التفصيلية:\")\n",
    "print(f\"🎯 الدقة الإجمالية: {evaluation_results['overall_accuracy']:.4f} ({evaluation_results['overall_accuracy']*100:.2f}%)\")\n",
    "\n",
    "print(f\"\\n📋 تقرير مفصل لكل نوع تصحيح:\")\n",
    "for i, correction_type in enumerate(target_cols):\n",
    "    y_true = y_test[:, i]\n",
    "    y_pred_single = y_pred_binary[:, i]\n",
    "    \n",
    "    accuracy = accuracy_score(y_true, y_pred_single)\n",
    "    \n",
    "    # حساب Precision, Recall, F1 يدوياً\n",
    "    tp = np.sum((y_pred_single == 1) & (y_true == 1))\n",
    "    fp = np.sum((y_pred_single == 1) & (y_true == 0))\n",
    "    fn = np.sum((y_pred_single == 0) & (y_true == 1))\n",
    "    \n",
    "    precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n",
    "    recall = tp / (tp + fn) if (tp + fn) > 0 else 0\n",
    "    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n",
    "    \n",
    "    evaluation_results['per_correction_metrics'][correction_type] = {\n",
    "        'accuracy': float(accuracy),\n",
    "        'precision': float(precision),\n",
    "        'recall': float(recall),\n",
    "        'f1_score': float(f1),\n",
    "        'true_positives': int(tp),\n",
    "        'false_positives': int(fp),\n",
    "        'false_negatives': int(fn)\n",
    "    }\n",
    "    \n",
    "    print(f\"\\n  📌 {correction_type}:\")\n",
    "    print(f\"    Accuracy: {accuracy:.4f}\")\n",
    "    print(f\"    Precision: {precision:.4f}\")\n",
    "    print(f\"    Recall: {recall:.4f}\")\n",
    "    print(f\"    F1-Score: {f1:.4f}\")\n",
    "\n",
    "# حفظ نتائج التقييم\n",
    "evaluation_file = f'{project_path}/results/model_evaluation.json'\n",
    "with open(evaluation_file, 'w') as f:\n",
    "    json.dump(evaluation_results, f, indent=2)\n",
    "\n",
    "print(f\"\\n💾 تم حفظ نتائج التقييم في: {evaluation_file}\")"
   ]
